# Kairos backend environment. Copy values into your hosting provider's
# environment settings; never commit a filled-in copy.

# PostgreSQL (either SPRING_DATASOURCE_URL, or the DB_* parts)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kairos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kairos
DB_USER=kairos
DB_PASSWORD=change-me

# HS256 signing key for access tokens: a random value of at least 32 bytes.
# Generate one with: openssl rand -base64 48
KAIROS_JWT_SECRET=

# How long an access token is valid (ISO-8601 duration)
KAIROS_TOKEN_TTL=PT12H

# Comma-separated browser origins allowed to call the API
KAIROS_CORS_ORIGINS=http://localhost:5173

# Port to listen on (Render sets this automatically)
PORT=8080

LOG_LEVEL=INFO
